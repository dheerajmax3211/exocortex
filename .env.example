# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM Provider: 'openai' (for DeepSeek direct) or 'commandcode'
LLM_PROVIDER=commandcode
LLM_BASE_URL=https://api.commandcode.ai
LLM_API_KEY=your-command-code-api-key
LLM_MODEL=deepseek/deepseek-v4-flash

# For direct DeepSeek (alternative):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your-deepseek-api-key
# LLM_MODEL=deepseek-flash

# GitHub backup (optional, for weekly backup cron)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_BACKUP_REPO=your-username/virtual-brain-backup

# Timezone
TZ=Asia/Kolkata
